{
  "name": "wikithoughts/auto-accept-orders-whmcs",
  "description": "WHMCS addon that automatically accepts paid and free pending orders.",
  "type": "whmcs-addon",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.45"
  },
  "autoload": {
    "psr-4": {
      "AutoAcceptOrders\\": "modules/addons/auto_accept_orders/lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AutoAcceptOrders\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true
  }
}
